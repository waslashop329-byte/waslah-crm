# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only, bypasses RLS. Used by webhook/sync jobs (Phase 3+).
# NEVER expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (Phase 5). Any OpenAI-compatible endpoint works via OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Per-provider webhook signing secrets (Phase 3), one per source, named
# <PROVIDER>_WEBHOOK_SECRET (matches the [provider] segment of
# /api/webhooks/[provider], uppercased). Only set one once that provider's
# real signing scheme is known — a source with no secret set here skips
# signature verification (fine for the mock provider, not for a real one).
# MAIN_SYSTEM_WEBHOOK_SECRET=

# Real operations-system integration (main-system-provider.ts). Both required
# for the "Waslah Ops System" card on /integrations to actually connect —
# without them it fails testConnection with a clear "not configured" message
# rather than silently doing nothing.
# MAIN_SYSTEM_BASE_URL=https://wasla-egy.com/api/v1
# MAIN_SYSTEM_API_KEY=

# Bearer secret for POST /api/sync — the scheduled-sync entrypoint a cron job
# or Trigger.dev calls. Generate a long random value; never commit a real one.
SYNC_API_SECRET=

# Real messaging provider (Phase 9's Communication Center + Phase 16
# campaigns). Leave MESSAGING_PROVIDER unset (or "mock") to keep every send
# logged-only, never actually delivered.
#
# Option A — Twilio (WhatsApp + SMS, but no free trial in some regions
# including Egypt — needs a paid account there):
# MESSAGING_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_SMS_FROM=
#
# Option B — Meta's WhatsApp Cloud API (WhatsApp only, free to test, no
# card required — from developers.facebook.com, WhatsApp > API Setup):
# MESSAGING_PROVIDER=meta_whatsapp
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_ACCESS_TOKEN=
